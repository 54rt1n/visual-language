{
  "name": "visual-language",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mandarin learning through branching conversations, guided lessons, and scheduled reviews.",
  "author": "Martin Bukowski <martin@bmds.us>",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "postinstall": "node scripts/patch-pinyin.mjs",
    "prebuild": "node scripts/patch-pinyin.mjs && node scripts/fetch-reading-dictionary.mjs --check",
    "dictionary:verify": "node scripts/fetch-reading-dictionary.mjs --check",
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.evaluation.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build && playwright test",
    "ux:providers": "npm run build && node scripts/capture-provider-ux.mjs",
    "test:lesson-generation": "node scripts/generate-lesson.mjs",
    "test:pages": "node scripts/verify-pages.mjs",
    "test:secrets": "node scripts/verify-production-secrets.mjs",
    "eval:reviews": "node scripts/evaluate-reviews.mjs",
    "eval:lesson-compare": "node scripts/compare-lessons.mjs",
    "eval:lesson-quality": "node scripts/score-lessons.mjs",
    "eval:lessons": "node scripts/evaluate-mandarin.mjs --suite lessons",
    "eval:mandarin": "node scripts/evaluate-mandarin.mjs",
    "eval:reading": "node scripts/evaluate-reading.mjs",
    "eval:pronunciation": "node scripts/evaluate-pronunciation.mjs",
    "eval:waypoints": "node scripts/evaluate-waypoints.mjs",
    "eval:lesson-stage": "node scripts/experiment-lesson-stage.mjs",
    "eval:native-protocol": "node scripts/evaluate-native-protocol.mjs",
    "eval:lesson-correction": "node scripts/evaluate-lesson-correction.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.44.0",
    "@noble/hashes": "2.4.0",
    "@pinyin-pro/data": "1.3.1",
    "@xyflow/svelte": "^1.6.5",
    "fflate": "0.8.3",
    "idb": "^8.0.3",
    "js-tiktoken": "1.0.21",
    "pinyin-pro": "3.29.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.6",
    "@types/node": "^24.10.1",
    "fake-indexeddb": "^6.2.5",
    "onnxruntime-web": "1.23.2",
    "svelte": "^5.43.8",
    "svelte-check": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.11"
  }
}
